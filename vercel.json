{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "redirects": [
    { "source": "/webmail", "destination": "https://webmail.neelamfilms.com:2096", "permanent": false },
    { "source": "/webmail/:path*", "destination": "https://webmail.neelamfilms.com:2096", "permanent": false },
    { "source": "/mail", "destination": "https://webmail.neelamfilms.com:2096", "permanent": false },
    { "source": "/cpanel", "destination": "https://cpanel.neelamfilms.com:2083", "permanent": false }
  ],
  "rewrites": [
    { "source": "/live-events", "destination": "/live-events.html" },
    { "source": "/camera-rental", "destination": "/camera-rental.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
